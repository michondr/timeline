# Never commit .env to git.

# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_DB=timeline
POSTGRES_USER=timeline
POSTGRES_PASSWORD=change_me_locally

# Port exposed on localhost (change if 5432 is taken)
DB_PORT=5432

# ── Ports ──────────────────────────────────────────────────────────────────
API_PORT=8080
FRONTEND_PORT=5173

# ── Symfony ────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
APP_SECRET=change_me_to_a_random_32char_hex_string

# Allowed CORS origins for the API (regex)
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# WebAuthn relying party (set to your public domain in production)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Timeline
