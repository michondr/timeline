# Copy to .env and edit before first run.
# Never commit .env to git.

# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_DB=timeline
POSTGRES_USER=timeline
POSTGRES_PASSWORD=change_me_locally

# Port exposed on localhost (change if 5432 is taken)
DB_PORT=5432

# ── Ports ──────────────────────────────────────────────────────────────────
API_PORT=8080
FRONTEND_PORT=5173

# ── Symfony ────────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
APP_SECRET=change_me_to_a_random_32char_hex_string
